<!DOCTYPE html>
<html lang="{{ page_lang }}" class="static detail-page content{{ portrait_modifier }}">
<meta http-equiv="content-type" content="text/html" />

<head>
  <meta charset="utf-8" />
  <title>{{ page_title }}</title>

  <link rel="preload" href="themes/style.css" as="style">
  <link rel="preload" href="{{ portrait_img }}" as="image">

  <style>
    /* Kritische Styles für sofortiges Rendering */
    #branding { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Ubuntu, Cantarell, "Noto Sans", sans-serif; font-weight: 300; font-size: 400%; }
    body { background: #F1f0ec; color: #111827; }
 </style>
  <link href="themes/style.css" rel="stylesheet" type="text/css" />

  <meta name="generator" content="DataRenderFunctions 1.0 - SEM" />
  <meta name="viewport" content="width=device-width" />

  <meta name="description" content="{{ meta_description }}">
  <meta property="og:title" content="{{ og_title }}">
  <meta property="og:description" content="{{ og_description }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="https://www.matzen.cloud/{{ portrait_img }}">{{ meta_dates }}

  <link rel="me" href="https://mastodon.social/@interface007" />
  <link rel="canonical" href="{{ canonical_url }}" />{{ hreflang_links }}

  <link rel="manifest" href="/site.webmanifest">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#ffffff">

  <link href="favicon.ico" rel="shortcut icon" type="image/x-icon" />

  <script>(function (d) { d.className = "dyn" + d.className.substring(6, d.className.length); })(document.documentElement);</script>
  <script>try{if(localStorage.getItem('theme')==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}</script>
  <script defer src="https://cloud.umami.is/script.js" data-website-id="4fef9786-837e-4b37-8b12-44e1f569ec8d"></script>
  <script defer src="/script/push-client.js"></script>
</head>

<body>
  <div class="aside-1">
    <div id="layout-wrapper">
      <part>
        <div id="layout-topBar" class="row" style="height: 10px;">
          <div id="topBar" class="col">
            <div class="user-display">
              <span class="user-actions">
              </span>
            </div>
          </div>
        </div>
        <header id="layout-header-container" class="row" style="min-height: 110px;">
          <div id="layout-header" class="col">
            <div class="zone zone-header">
              <h2 id="branding"><a href="index.html">Sven Erik Matzen</a></h2>
              <span id="brandingDescription">Software Architect | Cloud & Security Expert | AI-enabled Solutions</span>
            </div>
          </div>
        </header>

        <div id="layout-navigation-container" class="row" style="min-height: 114px;">
          <div id="layout-navigation" class="col">
            <div class="zone zone-navigation">
              <article class="widget-navigation widget-menu-widget widget">
                <nav>
                  <ul class="menu menu-main-menu">
                    <li><a href="index.html">Home</a></li>
                    <li><a href="professional.html">Professional</a></li>
                    <li><a href="projects.html">Projects</a></li>
                    <li><a href="mooc.html">MOOC</a></li>
                    <li><a href="mooc-provider.html">MOOC Providers</a></li>
                    <li><a href="biochemistry.html">Biochemistry</a></li>
                    <li><a href="articles.html">Articles</a></li>
                    <li><a href="profiles.html">Profiles</a></li>
                  </ul>
                </nav>
              </article>
            </div>
          </div>
        </div>
      </part>
      
      <div id="layout-main-container" class="row">
        <aside id="aside-first" class="col">
          <div class="zone zone-aside-first">
            <article class="widget-PictOfSven widget-aside-first widget-html-widget widget">
              <p><img alt="Sven Erik Matzen" src="{{ portrait_img }}" style="width: 180px; height: 180px;" /></p>
            </article>
          </div>
        </aside>
        <div id="layout-content" class="col">
          <div id="content">
            <div class="zone zone-content">
              <article class="page content-item">
                <header>
                  <h1 id="heading">{{ heading }}</h1>
                </header>
                <main>
{{ meta_content }}
{{ content }}
{{ disclaimer }}
                </main>
              </article>
            </div>
          </div>
        </div>
      </div>
      <footer id="layout-footer" class="row">
        <div class="zone zone-footer">
          <p><a href="privacypolicy.html">Privacy Policy</a></p>
        </div>
      </footer>
    </div>
  </div>
{{ foot_scripts }}
</body>

</html>