<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} – {{ site_title }}</title>
  <meta name="description" content="Shantychor Lägerdorf – maritimes Liedgut, Shantys und Seemannslieder seit 1988.">
  <meta name="built" content="{{ built }}">
  <link rel="icon" href="/assets/favicons/favicon.ico" sizes="any">
  <link rel="shortcut icon" href="/assets/favicons/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicons/favicon-48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/favicon-180.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicons/favicon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicons/favicon-512.png">
  <link rel="stylesheet" href="/assets/style.css">
  <script defer src="https://cloud.umami.is/script.js" data-website-id="53188402-4ce5-4255-9257-0dff2466b136"></script>
</head>
<body>
  <a class="skip-link" href="#content">Zum Inhalt springen</a>
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/">
        <img class="brand-mark" src="/assets/favicons/favicon-192.png" alt="" width="100" height="100">
        <span>{{ site_title }}</span>
      </a>
    </div>
  </header>
  <nav class="site-nav" aria-label="Hauptnavigation">
    <ul class="container">
{{ nav }}
    </ul>
  </nav>
  <main id="content" class="container content">
    <h1>{{ title }}</h1>
{{ body }}
  </main>
  <footer class="site-footer">
    <div class="container">
      <a href="#content" class="top-link">Nach oben</a>
      <p class="footer-links">{{ footer_links }}</p>
      <p>{{ footer }}</p>
    </div>
  </footer>
</body>
</html>
